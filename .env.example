# Copy this file to .env and fill in real values, then run `docker compose up -d`.
# On a real VPS also terminate TLS in front of the web container (Caddy/Traefik/nginx).

DB_NAME=pglife
DB_USER=pglife
DB_PASS=change-this-strong-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# Host port that maps to the container's port 80.
WEB_PORT=8080
